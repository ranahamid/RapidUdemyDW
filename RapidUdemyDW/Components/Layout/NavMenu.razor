@using RapidUdemyDW.Services
@inject DownloadManager DlManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">⚡ RapidUdemy DW</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> 📚 My Courses
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="downloads">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> 📥 Downloads
                @if (DlManager.ActiveJobCount > 0)
                {
                    <span class="badge bg-warning text-dark ms-1" style="font-size: 0.7rem;">@DlManager.ActiveJobCount</span>
                }
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="settings">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> ⚙️ Settings
            </NavLink>
        </div>
    </nav>
</div>
