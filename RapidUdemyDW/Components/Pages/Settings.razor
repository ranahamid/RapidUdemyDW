@page "/settings"
@using RapidUdemyDW.Models
@using RapidUdemyDW.Services
@inject UdemyApiService Api
@inject DownloadManager DlManager
@inject CourseCacheService Cache
@inject NavigationManager Nav

<div class="page-header">
    <h2>⚙️ Settings</h2>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible">
        @_message
        <button type="button" class="btn-close" @onclick="() => _message = null"></button>
    </div>
}

<div class="settings-card">
    <h5>🔑 Authentication</h5>
    <div class="mb-3">
        <label class="form-label">Access Token</label>
        <div class="input-group">
            <input type="@(_showToken ? "text" : "password")" class="form-control"
                   @bind="_settings.AccessToken" placeholder="Enter your Udemy access token" />
            <button class="btn btn-outline-secondary" @onclick="() => _showToken = !_showToken">
                @(_showToken ? "🙈 Hide" : "👁️ Show")
            </button>
        </div>
        <small class="text-muted">
            Get this from your browser cookies (access_token) at udemy.com
        </small>
    </div>
    <button class="btn btn-outline-primary btn-sm" @onclick="ValidateToken" disabled="@_validating">
        @if (_validating)
        {
            <span class="spinner-border spinner-border-sm me-1"></span>
        }
        🔍 Validate Token
    </button>
    @if (_tokenValid.HasValue)
    {
        <span class="ms-2 @(_tokenValid.Value ? "text-success" : "text-danger")">
            @(_tokenValid.Value ? $"✅ Valid — {_tokenUserName}" : "❌ Invalid token")
        </span>
    }
</div>

<div class="settings-card mt-3">
    <h5>📁 Download Options</h5>

    <div class="mb-3">
        <label class="form-label">Download Path</label>
        <input type="text" class="form-control" @bind="_settings.DownloadPath"
               placeholder="C:\Users\You\Downloads\UdemyCourses" />
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label">Preferred Video Quality</label>
            <select class="form-select" @bind="_settings.PreferredQuality">
                <option value="1080">1080p (Full HD)</option>
                <option value="720">720p (HD)</option>
                <option value="480">480p (SD)</option>
                <option value="360">360p (Low)</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Max Concurrent Downloads</label>
            <select class="form-select" @bind="_settings.MaxConcurrentDownloads">
                <option value="1">1 (Slow & Safe)</option>
                <option value="2">2</option>
                <option value="3">3 (Recommended)</option>
                <option value="5">5</option>
                <option value="8">8 (Fast)</option>
            </select>
        </div>
    </div>

    <div class="mb-3">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" @bind="_settings.SkipExistingFiles" id="skipExisting" />
            <label class="form-check-label" for="skipExisting">Skip files that already exist</label>
        </div>
    </div>
</div>

<div class="settings-card mt-3">
    <h5>💬 Subtitles / Captions</h5>

    <div class="mb-3">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" @bind="_settings.DownloadCaptions" id="downloadCaptions" />
            <label class="form-check-label" for="downloadCaptions">Download subtitles</label>
        </div>
    </div>

    @if (_settings.DownloadCaptions)
    {
        <div class="mb-3">
            <label class="form-label">Preferred Language</label>
            <select class="form-select" @bind="_settings.CaptionLanguage">
                <option value="en">English</option>
                <option value="es">Spanish</option>
                <option value="fr">French</option>
                <option value="de">German</option>
                <option value="pt">Portuguese</option>
                <option value="ja">Japanese</option>
                <option value="ko">Korean</option>
                <option value="zh">Chinese</option>
                <option value="ar">Arabic</option>
                <option value="hi">Hindi</option>
                <option value="ur">Urdu</option>
            </select>
        </div>
    }
</div>

<div class="mt-4 d-flex gap-2">
    <button class="btn btn-primary" @onclick="SaveSettings">
        💾 Save Settings
    </button>
    <button class="btn btn-outline-secondary" @onclick="GoBack">
        ← Back to Courses
    </button>
</div>

@code {
    private AppSettings _settings = new();
    private bool _showToken;
    private bool _validating;
    private bool? _tokenValid;
    private string? _tokenUserName;
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsHelper.LoadAsync();

        // If settings have no token, pre-fill with default
        if (string.IsNullOrWhiteSpace(_settings.AccessToken))
        {
            _settings.AccessToken = "";
        }

        if (string.IsNullOrWhiteSpace(_settings.DownloadPath))
        {
            _settings.DownloadPath = Path.Combine(
                Environment.GetFolderPath(Environment.SpecialFolder.UserProfile),
                "Downloads", "UdemyCourses");
        }
    }

    private async Task ValidateToken()
    {
        if (string.IsNullOrWhiteSpace(_settings.AccessToken))
        {
            _message = "Please enter an access token.";
            _isError = true;
            return;
        }

        _validating = true;
        _tokenValid = null;
        StateHasChanged();

        try
        {
            Api.SetAccessToken(_settings.AccessToken);
            DlManager.SetAccessToken(_settings.AccessToken);
            var (valid, name) = await Api.ValidateTokenAsync();
            _tokenValid = valid;
            _tokenUserName = name;
        }
        catch (Exception ex)
        {
            _tokenValid = false;
            _message = ex.Message;
            _isError = true;
        }
        finally
        {
            _validating = false;
            StateHasChanged();
        }
    }

    private async Task SaveSettings()
    {
        try
        {
            // Validate download path before saving
            var (pathValid, pathError) = SettingsHelper.ValidateDownloadPath(_settings.DownloadPath);
            if (!pathValid)
            {
                _message = $"⚠️ Download path: {pathError}";
                _isError = true;
                return;
            }

            await SettingsHelper.SaveAsync(_settings);

            if (!string.IsNullOrWhiteSpace(_settings.AccessToken))
            {
                Api.SetAccessToken(_settings.AccessToken);
                DlManager.SetAccessToken(_settings.AccessToken);
                // Clear course cache so it reloads with new token
                Cache.ClearCache();
            }

            // Apply MaxConcurrentDownloads to the download manager
            DlManager.SetMaxConcurrentDownloads(_settings.MaxConcurrentDownloads);

            _message = "Settings saved successfully!";
            _isError = false;
        }
        catch (Exception ex)
        {
            _message = $"Failed to save: {ex.Message}";
            _isError = true;
        }
    }

    private void GoBack() => Nav.NavigateTo("/");
}
