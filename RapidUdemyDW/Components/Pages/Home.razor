@page "/"
@using RapidUdemyDW.Models
@using RapidUdemyDW.Services
@inject UdemyApiService Api
@inject DownloadManager DlManager
@inject CourseCacheService Cache
@inject NavigationManager Nav

<div class="page-header">
    <h2>📚 My Courses</h2>
    @if (!string.IsNullOrEmpty(_userName))
    {
        <span class="badge bg-success">Logged in as @_userName</span>
    }
</div>

<div class="direct-link-box mb-3">
    <div class="d-flex gap-2 align-items-start">
        <span class="input-group-text" style="height: auto;">🔗</span>
        <textarea class="form-control" rows="@Math.Max(1, Math.Min(_directUrl.Split('\n').Length, 6))"
                  placeholder="Paste one or more Udemy course links (one per line)..."
                  @bind="_directUrl" @bind:event="oninput"
                  style="resize: vertical; min-height: 38px;"></textarea>
        <button class="btn btn-primary flex-shrink-0" @onclick="GoToDirectUrl"
                disabled="@(_resolvingUrl || string.IsNullOrWhiteSpace(_directUrl))">
            @if (_resolvingUrl)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
                <span>@_batchProgressText</span>
            }
            else
            {
                <span>⬇️ Download</span>
            }
        </button>
    </div>
    @if (_batchResults.Count > 0)
    {
        <div class="mt-2" style="font-size: 0.85rem;">
            @foreach (var result in _batchResults)
            {
                <div class="@(result.IsError ? "text-danger" : "text-success")">
                    @(result.IsError ? "⚠️" : "✅") @result.Message
                </div>
            }
            @if (_batchResults.Any(r => !r.IsError))
            {
                <a href="downloads" class="small">📥 View Downloads</a>
            }
        </div>
    }
</div>

@if (_loading)
{
    <div class="loading-overlay">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2">@_loadingMessage</p>
        @if (_totalCourseCount > 0)
        {
            <div class="progress mt-2" style="width: 200px; height: 6px;">
                <div class="progress-bar" style="width: @(_courses.Count * 100 / _totalCourseCount)%"></div>
            </div>
        }
    </div>
}
else if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger d-flex align-items-center">
        <span class="me-2">⚠️</span>
        <div>
            <strong>Error:</strong> @_error
            <br />
            <button class="btn btn-sm btn-outline-danger mt-2" @onclick="LoadCourses">Retry</button>
        </div>
    </div>
}
else if (_courses.Count == 0)
{
    <div class="alert alert-info">
        <p>No courses found. Make sure your access token is valid.</p>
        <a href="settings" class="btn btn-primary btn-sm">Go to Settings</a>
    </div>
}
else
{
    <div class="d-flex gap-2 mb-3 align-items-center">
        <input type="text" class="form-control search-box" placeholder="🔍 Search courses..."
               @bind="_searchText" @bind:event="oninput" />
        <button class="btn btn-outline-secondary btn-sm flex-shrink-0" @onclick="RefreshCourses" disabled="@_refreshing">
            @if (_refreshing)
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
            else
            {
                <span>🔄</span>
            }
        </button>
        <span class="text-muted flex-shrink-0" style="font-size: 0.8rem;">@_courses.Count courses</span>
    </div>

    <div class="course-grid">
        @foreach (var course in FilteredCourses)
        {
            <div class="course-card">
                <div class="course-image" @onclick="() => SelectCourse(course)">
                    <img src="@(course.ImageMedium ?? course.ImageSmall)" alt="@course.Title" loading="lazy" />
                    <div class="course-progress-bar">
                        <div class="course-progress-fill" style="width: @course.CompletionRatio%"></div>
                    </div>
                </div>
                <div class="course-info" @onclick="() => SelectCourse(course)">
                    <h5 class="course-title" title="@course.Title">@course.Title</h5>
                    <p class="course-meta">
                        <span>👨‍🏫 @course.InstructorNames</span>
                    </p>
                    <p class="course-meta">
                        <span>📖 @course.NumPublishedLectures lectures</span>
                        <span class="ms-2">✅ @($"{course.CompletionRatio:F0}")%</span>
                    </p>
                </div>
                <div class="course-action">
                    @{ var dlState = GetDownloadState(course.Id); }
                    @if (dlState == CourseDownloadState.Downloading)
                    {
                        <button class="btn btn-sm btn-warning w-100" disabled>
                            <span class="spinner-border spinner-border-sm me-1"></span> Downloading...
                        </button>
                    }
                    else if (dlState == CourseDownloadState.AllDownloaded)
                    {
                        <button class="btn btn-sm btn-success w-100" disabled>
                            ✅ All Downloaded
                        </button>
                    }
                    else if (_courseErrors.TryGetValue(course.Id, out var errMsg))
                    {
                        <button class="btn btn-sm btn-danger w-100" title="@errMsg" @onclick="() => OneClickDownload(course)" @onclick:stopPropagation="true">
                            ⚠️ Retry
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-primary w-100" @onclick="() => OneClickDownload(course)" @onclick:stopPropagation="true">
                            ⬇️ Download
                        </button>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private List<UdemyCourse> _courses = [];
    private bool _loading;
    private bool _refreshing;
    private string? _error;
    private string? _userName;
    private string _searchText = string.Empty;
    private string _loadingMessage = "Loading your courses...";
    private int _totalCourseCount;

    // Direct URL paste — supports multiple URLs (one per line)
    private string _directUrl = string.Empty;
    private bool _resolvingUrl;
    private string _batchProgressText = "";
    private List<BatchResult> _batchResults = [];

    private record BatchResult(string Message, bool IsError);

    // One-click download state tracking
    private readonly HashSet<long> _downloadingCourses = [];
    private readonly HashSet<long> _allDownloadedCourses = [];
    private readonly Dictionary<long, string> _courseErrors = [];

    private IEnumerable<UdemyCourse> FilteredCourses =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _courses
            : _courses.Where(c => c.Title.Contains(_searchText, StringComparison.OrdinalIgnoreCase));

    private enum CourseDownloadState { Ready, Downloading, AllDownloaded }

    private CourseDownloadState GetDownloadState(long courseId)
    {
        if (_downloadingCourses.Contains(courseId)) return CourseDownloadState.Downloading;
        if (_allDownloadedCourses.Contains(courseId)) return CourseDownloadState.AllDownloaded;
        return CourseDownloadState.Ready;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Api.HasToken)
        {
            var prefs = await SettingsHelper.LoadAsync();
            if (!string.IsNullOrWhiteSpace(prefs.AccessToken))
            {
                Api.SetAccessToken(prefs.AccessToken);
                DlManager.SetAccessToken(prefs.AccessToken);
            }
            else
            {
                Nav.NavigateTo("settings");
                return;
            }
        }

        await LoadCourses();
    }

    private async Task LoadCourses()
    {
        _error = null;

        // 1. Try loading from cache first (instant)
        var cached = await Cache.LoadFromCacheAsync();
        if (cached.Count > 0)
        {
            _courses = cached;
            _loading = false;
            StateHasChanged();

            // Validate token in the background
            var (valid, name) = await Api.ValidateTokenAsync();
            if (valid) _userName = name;

            // Refresh in background if cache is stale
            if (Cache.IsCacheStale())
                _ = RefreshCoursesInBackground();

            return;
        }

        // 2. No cache — fetch from API with progress
        _loading = true;
        _loadingMessage = "Loading your courses...";
        StateHasChanged();

        try
        {
            var (valid, name) = await Api.ValidateTokenAsync();
            if (!valid)
            {
                _error = "Invalid access token. Please update it in Settings.";
                _loading = false;
                StateHasChanged();
                return;
            }
            _userName = name;

            _courses = [];
            await Api.GetMyCoursesAsync(_courses, async (loaded, total) =>
            {
                _totalCourseCount = total;
                _loadingMessage = $"Loading courses... {loaded} / {total}";
                await InvokeAsync(StateHasChanged);
            });

            // Save to cache
            await Cache.SaveToCacheAsync(_courses);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void SelectCourse(UdemyCourse course)
    {
        Nav.NavigateTo($"course/{course.Id}");
    }

    private async Task OneClickDownload(UdemyCourse course)
    {
        if (_downloadingCourses.Contains(course.Id)) return;

        _courseErrors.Remove(course.Id);
        _allDownloadedCourses.Remove(course.Id);
        _downloadingCourses.Add(course.Id);
        StateHasChanged();

        try
        {
            var job = await DlManager.StartCourseDownloadAsync(course.Id);

            if (job == null)
            {
                // All files already downloaded
                _downloadingCourses.Remove(course.Id);
                _allDownloadedCourses.Add(course.Id);
            }
            else
            {
                // Download started in background — remove "downloading" spinner
                // The job is now tracked in DlManager.Jobs; user can see progress in Downloads page
                _downloadingCourses.Remove(course.Id);
            }
        }
        catch (Exception ex)
        {
            _downloadingCourses.Remove(course.Id);
            _courseErrors[course.Id] = ex.Message;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task GoToDirectUrl()
    {
        if (string.IsNullOrWhiteSpace(_directUrl)) return;

        // Parse all non-empty lines as separate URLs
        var urls = _directUrl
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(u => !string.IsNullOrWhiteSpace(u))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (urls.Count == 0) return;

        _resolvingUrl = true;
        _batchResults = [];
        _batchProgressText = urls.Count == 1 ? "Processing..." : $"0 / {urls.Count}";
        StateHasChanged();

        try
        {
            for (int i = 0; i < urls.Count; i++)
            {
                var url = urls[i];
                _batchProgressText = urls.Count == 1 ? "Processing..." : $"{i + 1} / {urls.Count}";
                await InvokeAsync(StateHasChanged);

                try
                {
                    var course = await Api.GetCourseByUrlAsync(url);
                    if (course == null)
                    {
                        _batchResults.Add(new(TruncateUrl(url) + " — course not found or not enrolled", true));
                        continue;
                    }

                    var job = await DlManager.StartCourseDownloadAsync(course.Id);

                    if (job == null)
                        _batchResults.Add(new($"\"{course.Title}\" — all files already downloaded", false));
                    else
                        _batchResults.Add(new($"\"{course.Title}\" — download started ({job.TotalTasks} files)", false));
                }
                catch (Exception ex)
                {
                    _batchResults.Add(new($"{TruncateUrl(url)} — {ex.Message}", true));
                }

                await InvokeAsync(StateHasChanged);
            }

            _directUrl = string.Empty;
        }
        finally
        {
            _resolvingUrl = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string TruncateUrl(string url) =>
        url.Length > 60 ? url[..57] + "..." : url;

    private async Task RefreshCourses()
    {
        await RefreshCoursesInBackground();
    }

    private async Task RefreshCoursesInBackground()
    {
        if (_refreshing) return;
        _refreshing = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var fresh = new List<UdemyCourse>();
            await Api.GetMyCoursesAsync(fresh);

            if (fresh.Count > 0)
            {
                _courses = fresh;
                await Cache.SaveToCacheAsync(fresh);
            }
        }
        catch { /* background refresh — don't show error */ }
        finally
        {
            _refreshing = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
