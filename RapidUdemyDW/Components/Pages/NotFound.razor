@page "/not-found"
@layout MainLayout
@inject NavigationManager Nav

<div class="text-center" style="margin-top: 80px;">
    <h1 style="font-size: 4rem;">🔍</h1>
    <h3>Page Not Found</h3>
    <p class="text-muted">Sorry, the content you are looking for does not exist.</p>
    <button class="btn btn-primary mt-3" @onclick="GoHome">
        ← Back to My Courses
    </button>
</div>

@code {
    private void GoHome() => Nav.NavigateTo("/");
}
